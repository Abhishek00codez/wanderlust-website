<div class="toast-container">
<% if (success && success.length > 0) { %>
<div class="toast toast-success align-items-center show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="4000">
    <div class="d-flex">
        <div class="toast-body">
            <i class="fa-solid fa-circle-check text-success me-2"></i>
            <%= success %>
        </div>
        <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
</div>
<% } %>

<% if (error && error.length > 0) { %>
<div class="toast toast-error align-items-center show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="4000">
    <div class="d-flex">
        <div class="toast-body">
            <i class="fa-solid fa-circle-exclamation text-danger me-2"></i>
            <%= error %>
        </div>
        <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
</div>
<% } %>
</div>