<% layout("/layouts/boilerplate") %>

<div class="row mt-4 g-4">
    <!-- Left Column: Image & Details -->
    <div class="col-md-7">
        <div class="show-card">
            <img src="<%= listing.image.url %>"
                 class="card-img-top show-img"
                 alt="<%= listing.title %>">
            <div class="show-details">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h2 class="show-title"><%= listing.title %></h2>
                        <p class="show-owner">Hosted by <b>@<%= listing.owner.username %></b></p>
                    </div>
                    <% if(listing.category) { %>
                        <span class="category-badge"><%= listing.category %></span>
                    <% } %>
                </div>

                <p class="text-muted mb-3"><%= listing.description %></p>

                <div class="show-meta">
                    <div class="show-meta-item">
                        <i class="fa-solid fa-location-dot"></i>
                        <span><%= listing.location %>, <%= listing.country %></span>
                    </div>
                    <div class="show-meta-item">
                        <i class="fa-solid fa-indian-rupee-sign"></i>
                        <span class="show-price-tag">
                            &#8377; <%= listing.price.toLocaleString("en-IN") %> <span>/ night</span>
                        </span>
                    </div>
                </div>

                <% if(currUser && currUser._id.equals(listing.owner._id)){ %>
                <div class="show-actions">
                    <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn">
                        <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                    </a>
                    <button class="btn btn-delete" data-bs-toggle="modal" data-bs-target="#deleteListingModal">
                        <i class="fa-solid fa-trash me-1"></i> Delete
                    </button>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Right Column: Reviews -->
    <div class="col-md-5">
        <% if(currUser){ %>
        <div class="mb-4 p-3" style="background:var(--light-gray);border-radius:var(--radius-lg);">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-star me-1" style="color:var(--primary);"></i>Leave a Review</h5>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                <div class="mb-3">
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
                <div class="mb-3">
                    <textarea class="form-control" name="review[comment]" rows="3" placeholder="Share your experience..." required></textarea>
                    <div class="invalid-feedback">Please write a comment.</div>
                </div>
                <button class="btn btn-primary-custom w-100">Submit Review</button>
            </form>
        </div>
        <% } %>

        <h5 class="fw-bold mb-3">
            <i class="fa-solid fa-comments me-1"></i>
            Reviews (<%= listing.reviews.length %>)
        </h5>

        <% if(listing.reviews.length === 0) { %>
            <p class="text-muted"><i class="fa-regular fa-comment me-1"></i>No reviews yet. Be the first to review!</p>
        <% } %>

        <div class="d-flex flex-column gap-3">
            <% for(let review of listing.reviews){ %>
            <div class="review-card">
                <div class="review-header">
                    <div class="review-avatar">
                        <%= review.author.username.charAt(0).toUpperCase() %>
                    </div>
                    <div>
                        <p class="review-author mb-0">@<%= review.author.username %></p>
                        <p class="starability-result mb-0" data-rating="<%= review.rating %>" style="font-size:0.75rem;"></p>
                    </div>
                </div>
                <p class="mb-2 mt-2" style="font-size:0.9rem;"><%= review.comment %></p>
                <% if(currUser && currUser._id.equals(review.author._id)){ %>
                <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                    <button class="btn btn-sm btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#deleteReviewModal-<%= review._id %>">
                        <i class="fa-solid fa-trash-can me-1"></i>Delete
                    </button>
                </form>

                <!-- Delete Review Modal -->
                <div class="modal fade" id="deleteReviewModal-<%= review._id %>" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered modal-sm">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h6 class="modal-title">Delete Review?</h6>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p class="mb-0">This action cannot be undone.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                    <button class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Delete Listing Modal -->
<% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)){ %>
<div class="modal fade" id="deleteListingModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Delete Listing</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <b>"<%= listing.title %>"</b>?</p>
                <p class="text-muted mb-0">This will permanently remove the listing and all its reviews.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i>Delete Permanently</button>
                </form>
            </div>
        </div>
    </div>
</div>
<% } %>
